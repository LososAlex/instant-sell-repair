# Секреты repair-worker Instant Sell. Скопируй в .env рядом и заполни; .env в git не попадает.
# Причины поломок, интервалы, URL и топики — в config.py, они коммитятся.
# Комментарии только отдельной строкой.

# mm-inventory: accounts_p2p и repair_queue.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER/mm-inventory
# x-bots-admin-key того контура, куда смотрит API_URL в config.py (сейчас тестовый).
SWAPS_ADMIN_KEY=
TELEGRAM_BOT_TOKEN=
# x-api-key сервиса bot_events. Пусто = события не шлём.
MONITORING_KEY=
# x-cv-key API свопа: PATCH /bots/{id}/dead (замодеренные INVENTORY -> DEAD). Пусто = не списываем.
CV_KEY=

# Postgres бэка, куда смотрит API_URL (только чтение inventory_items): капча + 0 предметов -> DEAD.
# Формат postgresql://USER:PASSWORD@HOST/DB?sslmode=require. Пусто = не списываем.
SWAPS_PG_DSN=
# API-KEY хаба Worker3 (POST /mm2/buy-vip), тот же, что у ротатора: купить VIP боту MM2 в проде,
# у которого его нет (NO_ACCESS_TO_PRVT_SERVER). Пусто = не покупаем, только алерт.
VIP_API_KEY=
